{
  "$defs": {
    "AnalysisUpdate": {
      "additionalProperties": false,
      "properties": {
        "stance": {
          "enum": [
            "initial",
            "maintained",
            "revised",
            "unable_to_compare"
          ],
          "title": "Stance",
          "type": "string"
        },
        "changed_claims": {
          "items": {
            "$ref": "#/$defs/ClaimUpdate"
          },
          "maxItems": 8,
          "title": "Changed Claims",
          "type": "array"
        },
        "reasons": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "decisive_evidence_keys": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Decisive Evidence Keys",
          "type": "array"
        }
      },
      "required": [
        "stance",
        "changed_claims",
        "reasons",
        "decisive_evidence_keys"
      ],
      "title": "AnalysisUpdate",
      "type": "object"
    },
    "AssessmentAxes": {
      "additionalProperties": false,
      "properties": {
        "source_reliability": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceReliabilityAssessment"
          },
          "title": "Source Reliability",
          "type": "array"
        },
        "information_credibility": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InformationCredibilityAssessment"
          },
          "title": "Information Credibility",
          "type": "array"
        },
        "evidence_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Level"
        },
        "heat": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heat"
        }
      },
      "title": "AssessmentAxes",
      "type": "object"
    },
    "ClaimReview": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "grounded",
            "overstated",
            "unsupported",
            "uncertain"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "issue": {
          "maxLength": 2000,
          "title": "Issue",
          "type": "string"
        },
        "evidence_keys": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Keys",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "verdict",
        "issue",
        "evidence_keys"
      ],
      "title": "ClaimReview",
      "type": "object"
    },
    "ClaimUpdate": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "previous_claim_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Claim Id"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_keys": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Keys",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "previous_claim_id",
        "reason",
        "evidence_keys"
      ],
      "title": "ClaimUpdate",
      "type": "object"
    },
    "CompetingHypothesis": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "explanation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "supporting_claim_ids": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "title": "Supporting Claim Ids",
          "type": "array"
        },
        "opposing_claim_ids": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "title": "Opposing Claim Ids",
          "type": "array"
        },
        "discriminating_evidence_needed": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Discriminating Evidence Needed",
          "type": "string"
        },
        "untested_conditions": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Untested Conditions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "explanation",
        "discriminating_evidence_needed"
      ],
      "title": "CompetingHypothesis",
      "type": "object"
    },
    "ConditionalAnswer": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "conditions": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Conditions",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "answer",
        "conditions",
        "unknowns"
      ],
      "title": "ConditionalAnswer",
      "type": "object"
    },
    "DraftFinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "section": {
          "anyOf": [
            {
              "enum": [
                "claims",
                "explanations",
                "gaps",
                "conditional_answer",
                "update"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "claim_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "issue": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Issue",
          "type": "string"
        },
        "evidence_keys": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Keys",
          "type": "array"
        }
      },
      "required": [
        "issue",
        "evidence_keys"
      ],
      "title": "DraftFinding",
      "type": "object"
    },
    "EvidenceGap": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "why_it_matters": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Why It Matters",
          "type": "string"
        }
      },
      "required": [
        "id",
        "question",
        "why_it_matters"
      ],
      "title": "EvidenceGap",
      "type": "object"
    },
    "Explanation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "for_claim_ids": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "For Claim Ids",
          "type": "array"
        },
        "against_claim_ids": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Against Claim Ids",
          "type": "array"
        },
        "discriminating_evidence_needed": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Discriminating Evidence Needed",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "for_claim_ids",
        "against_claim_ids",
        "discriminating_evidence_needed"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "GenericReview": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "status": {
          "enum": [
            "passed",
            "needs_review"
          ],
          "title": "Status",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimReview"
          },
          "maxItems": 8,
          "minItems": 0,
          "title": "Claims",
          "type": "array"
        },
        "overall_limitations": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Overall Limitations",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/DraftFinding"
          },
          "maxItems": 8,
          "title": "Findings",
          "type": "array"
        },
        "checked_sections": {
          "items": {
            "enum": [
              "claims",
              "explanations",
              "gaps",
              "conditional_answer",
              "update"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "title": "Checked Sections",
          "type": "array"
        }
      },
      "required": [
        "status",
        "claims",
        "overall_limitations"
      ],
      "title": "GenericReview",
      "type": "object"
    },
    "HypothesisJudgment": {
      "additionalProperties": false,
      "properties": {
        "least_refuted_hypothesis_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Least Refuted Hypothesis Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "next_discriminating_evidence": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Next Discriminating Evidence",
          "type": "string"
        },
        "qualification": {
          "const": "这是模型判断，未证实",
          "default": "这是模型判断，未证实",
          "title": "Qualification",
          "type": "string"
        }
      },
      "required": [
        "least_refuted_hypothesis_id",
        "reason",
        "next_discriminating_evidence"
      ],
      "title": "HypothesisJudgment",
      "type": "object"
    },
    "InformationCredibilityAssessment": {
      "additionalProperties": false,
      "properties": {
        "record_ref": {
          "$ref": "#/$defs/ProviderRef"
        },
        "assessment_status": {
          "default": "not_assessed",
          "enum": [
            "not_assessed",
            "machine_assessed",
            "human_reviewed"
          ],
          "title": "Assessment Status",
          "type": "string"
        },
        "reason_code": {
          "default": "basis_missing",
          "title": "Reason Code",
          "type": "string"
        },
        "assessment_basis_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProviderRef"
          },
          "title": "Assessment Basis Refs",
          "type": "array"
        },
        "assessment_basis": {
          "default": "",
          "title": "Assessment Basis",
          "type": "string"
        },
        "assessed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed By"
        },
        "assessed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed At"
        },
        "taxonomy_name": {
          "const": "admiralty-scale",
          "default": "admiralty-scale",
          "title": "Taxonomy Name",
          "type": "string"
        },
        "taxonomy_version": {
          "const": 5,
          "default": 5,
          "title": "Taxonomy Version",
          "type": "integer"
        },
        "native_review_entry_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Review Entry Id"
        },
        "review_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Revision"
        },
        "previous_assessment_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Assessment Ref"
        },
        "grade": {
          "default": "6",
          "enum": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6"
          ],
          "title": "Grade",
          "type": "string"
        },
        "claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "claim_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Text"
        },
        "claim_text_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Text Sha256"
        },
        "independent_confirmation_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProviderRef"
          },
          "title": "Independent Confirmation Refs",
          "type": "array"
        },
        "independent_confirmation_basis": {
          "default": "",
          "title": "Independent Confirmation Basis",
          "type": "string"
        }
      },
      "required": [
        "record_ref"
      ],
      "title": "InformationCredibilityAssessment",
      "type": "object"
    },
    "JsonValue": {},
    "ProviderRef": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "object_type": {
          "minLength": 1,
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "adopted_version": {
          "minLength": 1,
          "title": "Adopted Version",
          "type": "string"
        },
        "version_source": {
          "enum": [
            "provider",
            "export_hash"
          ],
          "title": "Version Source",
          "type": "string"
        },
        "content_hash": {
          "minLength": 1,
          "title": "Content Hash",
          "type": "string"
        },
        "authorization_ref": {
          "minLength": 1,
          "title": "Authorization Ref",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "object_type",
        "object_id",
        "adopted_version",
        "version_source",
        "content_hash",
        "authorization_ref"
      ],
      "title": "ProviderRef",
      "type": "object"
    },
