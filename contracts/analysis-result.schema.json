        },
        "assessment_basis": {
          "default": "",
          "title": "Assessment Basis",
          "type": "string"
        },
        "assessed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed By"
        },
        "assessed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed At"
        },
        "taxonomy_name": {
          "const": "admiralty-scale",
          "default": "admiralty-scale",
          "title": "Taxonomy Name",
          "type": "string"
        },
        "taxonomy_version": {
          "const": 5,
          "default": 5,
          "title": "Taxonomy Version",
          "type": "integer"
        },
        "native_review_entry_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
