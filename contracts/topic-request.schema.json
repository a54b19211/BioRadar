{
  "$defs": {
    "TopicDefinition": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "domain": {
          "enum": [
            "pipeline",
            "research",
            "business",
            "public_health",
            "policy",
            "regulatory",
            "supply",
            "regional",
            "other"
          ],
          "title": "Domain",
          "type": "string"
        },
        "source_instance": {
          "default": "datafabric-test",
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Instance",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "source_sites": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Source Sites",
          "type": "array"
        },
        "terms_all": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Terms All",
          "type": "array"
        },
        "terms_any": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Terms Any",
          "type": "array"
        },
        "profiles": {
          "items": {
            "enum": [
              "text_exposure",
              "registered_state",
              "typed_metric",
              "source_event"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Profiles",
          "type": "array"
        },
        "metric_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Metric Ids",
          "type": "array"
        },
        "bucket": {
          "default": "month",
          "enum": [
            "week",
            "month"
          ],
          "title": "Bucket",
          "type": "string"
        },
        "lookback_buckets": {
          "default": 24,
          "maximum": 120,
          "minimum": 3,
          "title": "Lookback Buckets",
          "type": "integer"
        },
        "cadence_hours": {
          "default": 24,
          "maximum": 720,
          "minimum": 1,
          "title": "Cadence Hours",
          "type": "integer"
        },
        "minimum_support": {
          "default": 2,
          "maximum": 100,
          "minimum": 2,
          "title": "Minimum Support",
          "type": "integer"
        }
      },
      "required": [
        "title",
        "question",
        "domain",
        "source_ids",
        "profiles"
      ],
      "title": "TopicDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "is_demo": {
      "default": false,
      "title": "Is Demo",
      "type": "boolean"
    },
    "definition": {
      "$ref": "#/$defs/TopicDefinition"
    }
  },
  "required": [
    "definition"
  ],
  "title": "TopicCreate",
  "type": "object"
}
