{
  "additionalProperties": false,
  "properties": {
    "title": {
      "default": "图谱引导的有界调查",
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "question": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "source_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_record_id": {
      "maxLength": 400,
      "minLength": 1,
      "title": "Source Record Id",
      "type": "string"
    },
    "graph_version_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Graph Version Id",
      "type": "string"
    },
    "is_demo": {
      "default": false,
      "title": "Is Demo",
      "type": "boolean"
    },
    "seed_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Seed Ids",
      "type": "array"
    },
    "seed_names": {
      "default": [],
      "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 3,
      "title": "Seed Names",
      "type": "array"
    },
    "relation_types": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Relation Types",
      "type": "array"
    },
    "direction": {
      "default": "both",
      "enum": [
        "out",
        "in",
        "both"
      ],
      "title": "Direction",
      "type": "string"
    },
    "max_depth": {
      "default": 1,
      "maximum": 2,
      "minimum": 1,
      "title": "Max Depth",
      "type": "integer"
    },
    "max_nodes": {
      "default": 40,
      "maximum": 100,
      "minimum": 1,
      "title": "Max Nodes",
      "type": "integer"
    },
    "max_edges": {
      "default": 60,
      "maximum": 200,
      "minimum": 1,
      "title": "Max Edges",
      "type": "integer"
    },
    "max_followups": {
      "default": 2,
      "maximum": 2,
      "minimum": 0,
      "title": "Max Followups",
      "type": "integer"
    },
    "max_evidence_records": {
      "default": 4,
      "maximum": 4,
      "minimum": 0,
      "title": "Max Evidence Records",
      "type": "integer"
    },
    "topic_terms": {
      "default": [],
      "items": {
        "maxLength": 120,
        "minLength": 2,
        "type": "string"
      },
      "maxItems": 2,
      "title": "Topic Terms",
      "type": "array"
    },
    "search_clinicaltrials": {
      "default": true,
      "title": "Search Clinicaltrials",
      "type": "boolean"
    },
    "compare_version_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compare Version Id"
    },
    "investigation_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Investigation Id"
    },
    "expected_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "mode": {
      "default": "current",
      "enum": [
        "current",
        "operational_replay",
        "public_history_reconstruction"
      ],
      "title": "Mode",
      "type": "string"
    },
    "cutoff": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cutoff"
    }
  },
  "required": [
    "question",
    "source_id",
    "source_record_id",
    "graph_version_id"
  ],
  "title": "GraphInvestigationCreate",
  "type": "object"
}
