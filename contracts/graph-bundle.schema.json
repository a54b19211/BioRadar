{
  "$defs": {
    "GraphDocumentRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_record_id": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "version_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Version Id",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "origin_doc_uuid": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Doc Uuid"
        }
      },
      "required": [
        "source_id",
        "source_record_id",
        "version_id",
        "raw_sha256"
      ],
      "title": "GraphDocumentRef",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/GraphIdentity"
        },
        "target": {
          "$ref": "#/$defs/GraphIdentity"
        },
        "relation_type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Relation Type",
          "type": "string"
        },
        "directed": {
          "const": true,
          "default": true,
          "title": "Directed",
          "type": "boolean"
        },
        "relation_props": {
          "additionalProperties": true,
          "title": "Relation Props",
          "type": "object"
        },
        "valid_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphTime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "valid_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphTime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review": {
          "$ref": "#/$defs/GraphReview"
        },
        "binding_status": {
          "enum": [
            "bound",
            "unbound",
            "background"
          ],
          "title": "Binding Status",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GraphEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "source_doc_uuid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Doc Uuid"
        },
        "unbound_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unbound Reason"
        },
        "field_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GraphFieldEvidence"
          },
          "title": "Field Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "relation_type",
        "review",
        "binding_status"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphEvidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_record_id": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "version_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Version Id",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "origin_doc_uuid": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Doc Uuid"
        },
        "quote": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/GraphLocator"
        }
      },
      "required": [
        "source_id",
        "source_record_id",
        "version_id",
        "raw_sha256",
        "quote",
        "locator"
      ],
      "title": "GraphEvidence",
      "type": "object"
    },
    "GraphFieldEvidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_record_id": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "version_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Version Id",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "origin_doc_uuid": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Doc Uuid"
        },
        "json_pointer": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "^/",
          "title": "Json Pointer",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "source_id",
        "source_record_id",
        "version_id",
        "raw_sha256",
        "json_pointer",
        "value"
      ],
      "title": "GraphFieldEvidence",
      "type": "object"
    },
    "GraphIdentity": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "id": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "id"
      ],
      "title": "GraphIdentity",
      "type": "object"
    },
    "GraphLocator": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "clean_text",
          "title": "Basis",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "basis",
        "start",
        "end"
      ],
      "title": "GraphLocator",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "id": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "entity_type": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "external_ids": {
          "additionalProperties": true,
          "title": "External Ids",
          "type": "object"
        },
        "identity_status": {
          "enum": [
            "confirmed",
            "rule_confirmed",
            "unresolved",
            "background"
          ],
          "title": "Identity Status",
          "type": "string"
        },
        "identity_review_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Review Basis"
        },
        "identity_rule": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Rule"
        },
        "field_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GraphFieldEvidence"
          },
          "title": "Field Evidence",
          "type": "array"
        },
        "review": {
          "$ref": "#/$defs/GraphReview"
        },
        "mention_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Mention Ids",
          "type": "array"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GraphEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "namespace",
        "id",
        "entity_type",
        "name",
        "identity_status",
        "review"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphRedirect": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/GraphIdentity"
        },
        "target": {
          "$ref": "#/$defs/GraphIdentity"
        },
        "merge_log_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Merge Log Id"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "merged_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Merged At"
        }
      },
      "required": [
        "source",
        "target",
        "merge_log_id"
      ],
      "title": "GraphRedirect",
      "type": "object"
    },
    "GraphReview": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        }
      },
      "required": [
        "status"
      ],
      "title": "GraphReview",
      "type": "object"
    },
    "GraphTime": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maxLength": 40,
          "minLength": 4,
          "title": "Value",
          "type": "string"
        },
        "precision": {
          "enum": [
            "year",
            "month",
            "day",
            "instant"
          ],
          "title": "Precision",
          "type": "string"
        },
        "meaning": {
          "default": "source_reported",
          "maxLength": 80,
          "title": "Meaning",
          "type": "string"
        }
      },
      "required": [
        "value",
        "precision"
      ],
      "title": "GraphTime",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "datafabric.graph.bundle.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "graph_kind": {
      "enum": [
        "reviewed",
        "background"
      ],
      "title": "Graph Kind",
      "type": "string"
    },
    "namespace": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Namespace",
      "type": "string"
    },
    "is_demo": {
      "title": "Is Demo",
      "type": "boolean"
    },
    "title": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "origin": {
      "enum": [
        "legacy_reviewed_export",
        "primekg_current_capture",
        "source_field_projection",
        "explicit_demo"
      ],
      "title": "Origin",
      "type": "string"
    },
    "scope_description": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Scope Description",
      "type": "string"
    },
    "selected_document_uuids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Selected Document Uuids",
      "type": "array"
    },
    "scope_record_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Scope Record Ids",
      "type": "array"
    },
    "scope_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope Manifest Sha256"
    },
    "scope_record_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope Record Count"
    },
    "batch_offset": {
      "default": 0,
      "minimum": 0,
      "title": "Batch Offset",
      "type": "integer"
    },
    "next_document_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Document Offset"
    },
    "dependency_source_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Dependency Source Ids",
      "type": "array"
    },
    "document_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraphDocumentRef"
      },
      "title": "Document Refs",
      "type": "array"
    },
    "selection_truncated": {
      "default": false,
      "title": "Selection Truncated",
      "type": "boolean"
    },
    "nodes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "maxItems": 1000,
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "maxItems": 3000,
      "title": "Edges",
      "type": "array"
    },
    "redirects": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraphRedirect"
      },
      "title": "Redirects",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "graph_kind",
    "namespace",
    "is_demo",
    "title",
    "origin",
    "scope_description"
  ],
  "title": "GraphBundle",
  "type": "object"
}
