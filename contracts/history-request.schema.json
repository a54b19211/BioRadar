{
  "$defs": {
    "HistoryTrainingRun": {
      "additionalProperties": false,
      "properties": {
        "cutoff": {
          "format": "date-time",
          "title": "Cutoff",
          "type": "string"
        },
        "run_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "cutoff",
        "run_id"
      ],
      "title": "HistoryTrainingRun",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "bioradar.history.request.v1",
      "default": "bioradar.history.request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "question": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "source_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "is_demo": {
      "default": false,
      "title": "Is Demo",
      "type": "boolean"
    },
    "mode": {
      "default": "public_history_reconstruction",
      "enum": [
        "current",
        "operational_replay",
        "public_history_reconstruction"
      ],
      "title": "Mode",
      "type": "string"
    },
    "cutoff": {
      "format": "date-time",
      "title": "Cutoff",
      "type": "string"
    },
    "target": {
      "enum": [
        "trial_stoppage",
        "regulatory_approval",
        "next_phase_disclosure"
      ],
      "title": "Target",
      "type": "string"
    },
    "horizon_months": {
      "default": 24,
      "enum": [
        12,
        24
      ],
      "title": "Horizon Months",
      "type": "integer"
    },
    "training_cutoffs": {
      "default": [],
      "items": {
        "format": "date-time",
        "type": "string"
      },
      "maxItems": 6,
      "title": "Training Cutoffs",
      "type": "array"
    },
    "training_runs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HistoryTrainingRun"
      },
      "maxItems": 6,
      "title": "Training Runs",
      "type": "array"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "cohort_terms": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "title": "Cohort Terms",
      "type": "array"
    },
    "max_records": {
      "default": 5000,
      "maximum": 20000,
      "minimum": 1,
      "title": "Max Records",
      "type": "integer"
    },
    "max_bytes": {
      "default": 8000000,
      "maximum": 32000000,
      "minimum": 1024,
      "title": "Max Bytes",
      "type": "integer"
    },
    "max_seconds": {
      "default": 90,
      "maximum": 120,
      "minimum": 5,
      "title": "Max Seconds",
      "type": "integer"
    },
    "review_budget": {
      "default": 10,
      "maximum": 1000,
      "minimum": 1,
      "title": "Review Budget",
      "type": "integer"
    },
    "followup_queries": {
      "default": 2,
      "maximum": 2,
      "minimum": 0,
      "title": "Followup Queries",
      "type": "integer"
    },
    "minimum_training_units": {
      "default": 3,
      "maximum": 100,
      "minimum": 2,
      "title": "Minimum Training Units",
      "type": "integer"
    }
  },
  "required": [
    "title",
    "question",
    "source_id",
    "cutoff",
    "target"
  ],
  "title": "HistoryStudyCreate",
  "type": "object"
}
