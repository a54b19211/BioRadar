{
  "$defs": {
    "DecisionBrief": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "audience": {
          "enum": [
            "central",
            "provincial",
            "university",
            "enterprise"
          ],
          "title": "Audience",
          "type": "string"
        },
        "decision_question": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Decision Question",
          "type": "string"
        },
        "mandate": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Mandate",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "decision_deadline": {
          "format": "date-time",
          "title": "Decision Deadline",
          "type": "string"
        },
        "horizon_start": {
          "format": "date",
          "title": "Horizon Start",
          "type": "string"
        },
        "horizon_end": {
          "format": "date",
          "title": "Horizon End",
          "type": "string"
        },
        "baseline_option_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Baseline Option Id",
          "type": "string"
        },
        "scope_description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Scope Description",
          "type": "string"
        },
        "why_now": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeclaredStatement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interest_declarations": {
          "$ref": "#/$defs/InterestDeclarations"
        },
        "review_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "title",
        "audience",
        "decision_question",
        "mandate",
        "as_of",
        "decision_deadline",
        "horizon_start",
        "horizon_end",
        "baseline_option_id",
        "scope_description"
      ],
      "title": "DecisionBrief",
      "type": "object"
    },
    "DecisionEvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "snapshot_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "record_ref": {
          "$ref": "#/$defs/ProviderRef"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "field_path": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        }
      },
      "required": [
        "snapshot_hash",
        "record_ref"
      ],
      "title": "DecisionEvidenceLink",
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "implementation_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeclaredStatement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "implementation_steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeclaredStatement"
          },
          "maxItems": 16,
          "title": "Implementation Steps",
          "type": "array"
        },
        "beneficiaries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeclaredStatement"
          },
          "maxItems": 16,
          "title": "Beneficiaries",
          "type": "array"
        },
        "adversely_affected": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeclaredStatement"
          },
          "maxItems": 16,
          "title": "Adversely Affected",
          "type": "array"
        },
        "irreversible_commitments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeclaredStatement"
          },
          "maxItems": 16,
          "title": "Irreversible Commitments",
          "type": "array"
        }
      },
      "required": [
        "option_id",
        "label",
        "description"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "DecisionScenario": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/InputBasis"
        }
      },
      "required": [
        "scenario_id",
        "label",
        "description",
        "basis"
      ],
      "title": "DecisionScenario",
      "type": "object"
    },
    "DeclaredStatement": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/InputBasis"
        }
      },
      "required": [
        "text",
        "basis"
      ],
      "title": "DeclaredStatement",
      "type": "object"
    },
    "HardConstraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "operator": {
          "enum": [
            "le",
            "ge"
          ],
          "title": "Operator",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unknown_reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Reason"
        },
        "basis": {
          "$ref": "#/$defs/InputBasis"
        }
      },
      "required": [
        "constraint_id",
        "label",
        "metric_id",
        "operator",
        "basis"
      ],
      "title": "HardConstraint",
      "type": "object"
    },
    "InputBasis": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "observed",
            "declared_assumption",
            "supplied_model_result"
          ],
          "title": "Kind",
          "type": "string"
        },
        "claimed_author": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Claimed Author",
          "type": "string"
        },
        "authored_at": {
          "format": "date-time",
          "title": "Authored At",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DecisionEvidenceLink"
          },
          "maxItems": 16,
          "title": "Evidence",
          "type": "array"
        },
        "model_description": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Description"
        }
      },
      "required": [
        "kind",
        "claimed_author",
        "authored_at",
        "rationale"
      ],
      "title": "InputBasis",
      "type": "object"
    },
    "InterestDeclarations": {
      "additionalProperties": false,
      "properties": {
        "commissioner": {
          "$ref": "#/$defs/InterestDisclosure"
        },
        "funder": {
          "$ref": "#/$defs/InterestDisclosure"
        },
        "author": {
          "$ref": "#/$defs/InterestDisclosure"
        },
        "reviewer": {
          "$ref": "#/$defs/InterestDisclosure"
        }
      },
      "title": "InterestDeclarations",
      "type": "object"
    },
    "InterestDisclosure": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "declared_none",
            "declared_interest"
          ],
          "title": "Status",
          "type": "string"
        },
        "statement": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeclaredStatement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "InterestDisclosure",
      "type": "object"
    },
    "MetricSpec": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ],
          "title": "Direction",
          "type": "string"
        },
        "unit": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "definition": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "population": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "geography": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Geography",
          "type": "string"
        },
        "jurisdiction": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Jurisdiction",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "price_base": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Base"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "comparability_basis": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Comparability Basis",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "label",
        "direction",
        "unit",
        "definition",
        "population",
        "geography",
        "jurisdiction",
        "period_start",
        "period_end",
        "comparability_basis"
      ],
      "title": "MetricSpec",
      "type": "object"
    },
    "NumericInterval": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Upper"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "NumericInterval",
      "type": "object"
    },
    "OutcomeCell": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "title": "Option Id",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unknown_reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Reason"
        },
        "basis": {
          "$ref": "#/$defs/InputBasis"
        }
      },
      "required": [
        "option_id",
        "scenario_id",
        "metric_id",
        "basis"
      ],
      "title": "OutcomeCell",
      "type": "object"
    },
    "ProviderRef": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "object_type": {
          "minLength": 1,
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "adopted_version": {
          "minLength": 1,
          "title": "Adopted Version",
          "type": "string"
        },
        "version_source": {
          "enum": [
            "provider",
            "export_hash"
          ],
          "title": "Version Source",
          "type": "string"
        },
        "content_hash": {
          "minLength": 1,
          "title": "Content Hash",
          "type": "string"
        },
        "authorization_ref": {
          "minLength": 1,
          "title": "Authorization Ref",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "object_type",
        "object_id",
        "adopted_version",
        "version_source",
        "content_hash",
        "authorization_ref"
      ],
      "title": "ProviderRef",
      "type": "object"
    },
    "ReviewPlan": {
      "additionalProperties": false,
      "properties": {
        "review_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review At"
        },
        "trigger_indicators": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeclaredStatement"
          },
          "maxItems": 16,
          "title": "Trigger Indicators",
          "type": "array"
        },
        "change_conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeclaredStatement"
          },
          "maxItems": 16,
          "title": "Change Conditions",
          "type": "array"
        },
        "basis": {
          "$ref": "#/$defs/InputBasis"
        }
      },
      "required": [
        "basis"
      ],
      "title": "ReviewPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "bioradar.decision.input.v1",
      "default": "bioradar.decision.input.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "input_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Input Id",
      "type": "string"
    },
    "is_demo": {
      "default": false,
      "title": "Is Demo",
      "type": "boolean"
    },
    "brief": {
      "$ref": "#/$defs/DecisionBrief"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricSpec"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/DecisionOption"
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Options",
      "type": "array"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/DecisionScenario"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    },
    "outcomes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OutcomeCell"
      },
      "maxItems": 12288,
      "title": "Outcomes",
      "type": "array"
    },
    "constraints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HardConstraint"
      },
      "maxItems": 32,
      "title": "Constraints",
      "type": "array"
    },
    "evidence_snapshot_hashes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Evidence Snapshot Hashes",
      "type": "array"
    }
  },
  "required": [
    "input_id",
    "brief",
    "metrics",
    "options",
    "scenarios"
  ],
  "title": "DecisionInput",
  "type": "object"
}
