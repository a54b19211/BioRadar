[Unit]
Description=MechEvidence professional methods
After=network.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h
EnvironmentFile=%h/.config/bioradar/mechevidence.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env ${BIORADAR_COMPONENT_PYTHON} -B -m mechevidence.service --host 127.0.0.1 --port 18561
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
