[Unit]
Description=query-planner decision service
After=network.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/zk_projects/query-planner
EnvironmentFile=%h/.config/bioradar/planner.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/zk_projects/query-planner/.venv/bin/uvicorn planner.service:app --host 127.0.0.1 --port 18561
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
