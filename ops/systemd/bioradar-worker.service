[Unit]
Description=BioRadar RQ worker
After=network.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/zk_projects/BioRadar
EnvironmentFile=%h/.config/bioradar/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/zk_projects/BioRadar/.venv/bin/python -m bioradar.ops.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
