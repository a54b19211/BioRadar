# Framework development only. make init creates a random local database password.
# Never put SSH passwords or upstream tokens in the front-end bundle.
COMPOSE_PROJECT_NAME=bioradar-dev
POSTGRES_PASSWORD=replace-with-generated-local-password
POSTGRES_PORT=15436
REDIS_PORT=16379
API_PORT=18100
WEB_PORT=15176

# Optional history reader. The URL must be reachable inside the API process network namespace.
DATA_FABRIC_HISTORY_URL=
DATA_FABRIC_HISTORY_READ_TOKEN=

# Optional separate current-document reader; otherwise uses DATA_FABRIC_HISTORY_URL.
DATA_FABRIC_RESEARCH_URL=

# Continuous discovery; no upstream writes or automatic professional judgment.
MONITOR_ENABLED=true
MONITOR_POLL_SECONDS=30
MONITOR_CONTEXT_RECORDS=2000
MONITOR_HOURLY_INVESTIGATIONS=6
MONITOR_COOLDOWN_MINUTES=60
