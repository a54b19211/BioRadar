# Copied to ops/.env by `make init`. Keep ops/.env private (chmod 600); never commit it.
COMPOSE_PROJECT_NAME=bioradar-dev
POSTGRES_PASSWORD=replace-with-generated-local-password
POSTGRES_PORT=15436
REDIS_PORT=16379
API_PORT=18100
WEB_PORT=15176

# Everything below is read by the radar (services/bioradar/config.py). Names are the setting names.
BIORADAR_DEV_CREDENTIAL=replace-with-generated-login
BIORADAR_SESSION_SECRET=replace-with-generated-session-key
BIORADAR_FABRIC_URL=http://127.0.0.1:18511
BIORADAR_FABRIC_READ_TOKEN=
BIORADAR_FABRIC_ADMIN_TOKEN=
BIORADAR_SOURCES='["pubmed","clinicaltrials","who_don","europe_pmc"]'
BIORADAR_DEMO_SOURCES='["external_archive"]'
# Live monitoring only; leave out bulk backfills such as legacy_documents (empty = same as SOURCES)
BIORADAR_MONITOR_SOURCES='["clinicaltrials","europe_pmc","who_don","fda_crl"]'

BIORADAR_WEKNORA_URL=
BIORADAR_WEKNORA_TOKEN=
BIORADAR_WEKNORA_KNOWLEDGE_BASE_ID=

BIORADAR_PLANNER_URL=http://127.0.0.1:18561
BIORADAR_PLANNER_TOKEN=
BIORADAR_BIOCHECK_URL=http://127.0.0.1:18562
BIORADAR_BIOCHECK_TOKEN=
# 逐句核验走 /v2/verify（断言单元）；v1 是退回的办法
BIORADAR_BIOCHECK_VERIFY=v2
BIORADAR_MECHEVIDENCE_URL=http://127.0.0.1:18563
BIORADAR_MECHEVIDENCE_TOKEN=

BIORADAR_LLM_PROVIDER=deepseek
BIORADAR_LLM_BASE_URL=https://api.deepseek.com
BIORADAR_LLM_MODEL=deepseek-flash
BIORADAR_LLM_API_KEY=

BIORADAR_MAX_STEPS=30
BIORADAR_MAX_READS=20
BIORADAR_MAX_LLM_CALLS=60
BIORADAR_MONITOR_ENABLED=false
BIORADAR_AUTO_ANALYSIS=false
