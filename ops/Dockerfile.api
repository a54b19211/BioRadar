FROM python:3.12-slim-bookworm
WORKDIR /app
RUN pip install --no-cache-dir uv==0.13.0
COPY pyproject.toml uv.lock ./
# the shared wheels are not on any index: pyproject's find-links ../extraction-contract/dist and
# ../llm-transport/dist resolve from /app to these two build contexts (compose.yaml additional_contexts)
COPY --from=contract-wheels . /extraction-contract/dist
COPY --from=transport-wheels . /llm-transport/dist
COPY services ./services
RUN uv sync --frozen --no-dev --no-editable
COPY db ./db
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
RUN useradd --create-home --uid 10001 bioradar
USER bioradar
CMD ["uvicorn", "bioradar.app:app", "--host", "0.0.0.0", "--port", "8100"]
